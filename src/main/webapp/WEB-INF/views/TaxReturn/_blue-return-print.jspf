<%@ page pageEncoding="UTF-8" %>
<c:set var="x" value="${page.extras}" />
<c:set var="provisionBadDebt" value="0" />
<c:forEach var="r" items="${page.statementRows}"><c:if test="${r.code eq 'PROVISION_BAD_DEBT'}"><c:set var="provisionBadDebt" value="${r.amount}" /></c:if></c:forEach>
<section id="section-blue-return-print" class="profit-loss-card tr-section print-section print-only tr-form-sheet" data-print-groups="return" aria-label="青色申告決算書">
    <div class="tr-sheet-page">
        <h2 class="tr-sheet-title"><c:out value="${page.yearLabel}" />分所得税青色申告決算書（一般用）　1ページ　損益計算書</h2>
        <p class="tr-sheet-note">
            様式参照状況：<c:out value="${page.blueReturnEdition.status}" />
            （<a href="<c:out value='${page.blueReturnEdition.sourceUrl}' />" target="_blank" rel="noopener noreferrer"><c:out value="${page.blueReturnEdition.sourceLabel}" /></a>）。
            所得税の申告・納付期限：<c:out value="${page.blueReturnEdition.filingDeadlineText}" />
            （<a href="<c:out value='${page.blueReturnEdition.deadlineSourceUrl}' />" target="_blank" rel="noopener noreferrer">国税庁の期限原則</a>）。
        </p>
        <table class="tr-sheet-table">
            <tbody>
                <tr><th>住所</th><td><c:out value="${x.filer.address}" /></td><th>氏名</th><td><c:out value="${x.filer.name}" /></td><th>屋号</th><td><c:out value="${x.filer.businessName}" /></td><th>業種名</th><td><c:out value="${x.filer.industry}" /></td></tr>
                <tr><th>事業所所在地</th><td class="tr-blank"></td><th>電話番号</th><td><c:out value="${x.filer.phone}" /></td><th>加入団体名</th><td class="tr-blank"></td><th>期間</th><td>自1月1日　至12月31日</td></tr>
                <tr><th>依頼税理士等</th><td colspan="7" class="tr-blank">（事務所所在地・氏名（名称）・電話番号を転記時に記入）</td></tr>
            </tbody>
        </table>
        <div class="tr-sheet-grid">
            <table class="tr-sheet-table">
                <thead><tr><th>欄</th><th>科目</th><th class="num">金額（円）</th></tr></thead>
                <tbody><c:forEach var="r" items="${page.statementMainRows}"><tr class="${r.total ? 'is-total' : ''}"><td class="no"><c:out value="${r.numberLabel}" /></td><th><c:out value="${r.label}" /></th><td class="num"><fmt:formatNumber value="${r.amount}" pattern="#,##0" /></td></tr></c:forEach></tbody>
            </table>
            <table class="tr-sheet-table">
                <thead><tr><th>欄</th><th>科目</th><th class="num">金額（円）</th></tr></thead>
                <tbody><c:forEach var="r" items="${page.statementIncomeRows}"><tr class="${r.total ? 'is-total' : ''}"><td class="no"><c:out value="${r.numberLabel}" /></td><th><c:out value="${r.label}" /></th><td class="num"><fmt:formatNumber value="${r.amount}" pattern="#,##0" /></td></tr></c:forEach></tbody>
            </table>
        </div>
        <p class="tr-sheet-note">欄番号は国税庁「所得税青色申告決算書（一般用）【令和5年分以降用】」（㉞〜㊺）に合わせています。空欄は本アプリで管理しない項目のため、正式様式への転記時に記入してください。</p>
    </div>

    <div class="tr-sheet-page">
        <h2 class="tr-sheet-title">2ページ　月別売上（収入）金額及び仕入金額・給料賃金・専従者給与・貸倒引当金・青色申告特別控除額の計算・地代家賃</h2>
        <div class="tr-sheet-grid">
            <table class="tr-sheet-table">
                <caption>月別売上（収入）金額及び仕入金額</caption>
                <thead><tr><th>月</th><th class="num">売上（収入）金額</th><th class="num">家事消費等</th><th class="num">仕入金額</th></tr></thead>
                <tbody>
                    <c:forEach var="m" items="${x.monthlySalesPurchases}"><tr><th>${m.month}月</th><td class="num"><fmt:formatNumber value="${m.sales}" pattern="#,##0" /></td><td class="num"><fmt:formatNumber value="${m.householdConsumption}" pattern="#,##0" /></td><td class="num"><fmt:formatNumber value="${m.purchases}" pattern="#,##0" /></td></tr></c:forEach>
                    <tr><th>雑収入</th><td class="num"><fmt:formatNumber value="${x.miscIncome}" pattern="#,##0" /></td><td></td><td></td></tr>
                    <tr class="is-total"><th>計</th><td class="num"><fmt:formatNumber value="${x.salesTotal + x.miscIncome}" pattern="#,##0" /></td><td class="num"><fmt:formatNumber value="${x.householdConsumptionTotal}" pattern="#,##0" /></td><td class="num"><fmt:formatNumber value="${x.purchaseTotal}" pattern="#,##0" /></td></tr>
                    <tr><th>うち軽減税率対象</th><td class="tr-blank"></td><td class="tr-blank"></td><td class="tr-blank"></td></tr>
                </tbody>
            </table>
            <div>
                <table class="tr-sheet-table">
                    <caption>貸倒引当金繰入額の計算</caption>
                    <tbody>
                        <tr><th>個別評価による本年分繰入額</th><td class="num tr-blank"></td></tr>
                        <tr><th>一括評価による本年分繰入限度額</th><td class="num tr-blank"></td></tr>
                        <tr class="is-total"><th>本年分の貸倒引当金繰入額（損益計算書㊴へ）</th><td class="num"><fmt:formatNumber value="${provisionBadDebt}" pattern="#,##0" /></td></tr>
                    </tbody>
                </table>
                <table class="tr-sheet-table">
                    <caption>青色申告特別控除額の計算</caption>
                    <tbody>
                        <tr><th>本年分の不動産所得の金額（青色申告特別控除前）</th><td class="num tr-blank">（不動産所得は本アプリ対象外）</td></tr>
                        <tr><th>青色申告特別控除前の所得金額（損益計算書㊸）</th><td class="num"><fmt:formatNumber value="${x.incomeBeforeBlue}" pattern="#,##0" /></td></tr>
                        <tr><th>控除の区分</th><td><c:out value="${page.deduction}" />万円控除（65万円・55万円又は10万円の各計算欄のうち該当欄へ転記）</td></tr>
                        <tr class="is-total"><th>青色申告特別控除額（損益計算書㊹へ）</th><td class="num"><fmt:formatNumber value="${x.blueDeductionApplied}" pattern="#,##0" /></td></tr>
                    </tbody>
                </table>
                <p class="tr-sheet-note">届出等の法定要件・適用可否は利用者が別途確認してください。</p>
            </div>
        </div>
        <table class="tr-sheet-table">
            <caption>給料賃金の内訳</caption>
            <thead><tr><th>氏名（職務・支給期）</th><th class="num">年齢</th><th class="num">従事月数</th><th class="num">給料賃金</th><th class="num">賞与</th><th class="num">合計（円）</th><th class="num">源泉徴収税額</th></tr></thead>
            <tbody>
                <c:forEach var="p" items="${x.employeeSalaryRows}"><c:if test="${not p.dedicated}"><tr><td><c:out value="${p.personName}" />（<c:out value="${p.jobDescription}" />・<c:out value="${p.paymentPeriod}" />）</td><td class="num tr-blank"></td><td class="num">${p.workMonths}</td><td class="num tr-blank"></td><td class="num tr-blank"></td><td class="num"><fmt:formatNumber value="${p.amount}" pattern="#,##0" /></td><td class="num tr-blank"></td></tr></c:if></c:forEach>
                <tr class="is-total"><th colspan="5">計（損益計算書⑳と一致）</th><td class="num"><fmt:formatNumber value="${x.salaries}" pattern="#,##0" /></td><td class="num tr-blank"></td></tr>
            </tbody>
        </table>
        <table class="tr-sheet-table">
            <caption>専従者給与の内訳</caption>
            <thead><tr><th>氏名（職務・支給期）</th><th>続柄</th><th class="num">年齢</th><th class="num">従事月数</th><th class="num">給料</th><th class="num">賞与</th><th class="num">合計（円）</th><th class="num">源泉徴収税額</th></tr></thead>
            <tbody>
                <c:forEach var="p" items="${x.employeeSalaryRows}"><c:if test="${p.dedicated}"><tr><td><c:out value="${p.personName}" />（<c:out value="${p.jobDescription}" />・<c:out value="${p.paymentPeriod}" />）</td><td class="tr-blank"></td><td class="num tr-blank"></td><td class="num">${p.workMonths}</td><td class="num tr-blank"></td><td class="num tr-blank"></td><td class="num"><fmt:formatNumber value="${p.amount}" pattern="#,##0" /></td><td class="num tr-blank"></td></tr></c:if></c:forEach>
                <tr class="is-total"><th colspan="6">計（損益計算書㊳と一致）</th><td class="num"><fmt:formatNumber value="${x.dedicatedSalary}" pattern="#,##0" /></td><td class="num tr-blank"></td></tr>
            </tbody>
        </table>
        <p class="tr-sheet-note">従事月数は登録した従事期間から算出しています。年齢・続柄・給料と賞与の内訳・源泉徴収税額は本アプリで管理しないため、源泉徴収簿等を確認して転記時に記入してください。支給額は会計仕訳と照合してください。</p>
        <table class="tr-sheet-table">
            <caption>地代家賃の内訳</caption>
            <thead><tr><th>支払先の住所・氏名</th><th>賃借物件</th><th>権・更・賃の別</th><th class="num">本年中の賃借料・権利金等</th><th class="num">左の賃借料のうち必要経費算入額</th></tr></thead>
            <tbody><c:forEach var="p" items="${x.rentRows}"><tr><td><c:out value="${p.address}" /> <c:out value="${p.name}" /></td><td><c:out value="${p.description}" /></td><td class="tr-blank"></td><td class="num"><fmt:formatNumber value="${p.amount}" pattern="#,##0" /></td><td class="num"><fmt:formatNumber value="${p.deductible}" pattern="#,##0" /></td></tr></c:forEach></tbody>
        </table>
        <table class="tr-sheet-table">
            <caption>家事消費等の登録明細</caption>
            <thead><tr><th>取引日</th><th>内容</th><th class="num">金額（円）</th></tr></thead>
            <tbody><c:forEach var="h" items="${x.householdConsumptionRows}"><tr><td><c:out value="${h.date}" /></td><td><c:out value="${h.details}" /></td><td class="num"><fmt:formatNumber value="${h.amount}" pattern="#,##0" /></td></tr></c:forEach></tbody>
        </table>
    </div>

    <div class="tr-sheet-page">
        <h2 class="tr-sheet-title">3ページ　売上（収入）金額・仕入金額の明細・減価償却費の計算・利子割引料・税理士等の報酬の内訳・本年中における特殊事情</h2>
        <div class="tr-sheet-grid">
            <table class="tr-sheet-table">
                <caption>売上（収入）金額の明細</caption>
                <thead><tr><th>売上先名</th><th>所在地</th><th>登録番号（法人番号）</th><th class="num">売上金額（円）</th></tr></thead>
                <tbody>
                    <c:forEach var="p" items="${x.salesPartnerRows}"><tr><td><c:out value="${p.name}" /></td><td><c:out value="${p.address}" /></td><td class="tr-blank"></td><td class="num"><fmt:formatNumber value="${p.amount}" pattern="#,##0" /></td></tr></c:forEach>
                    <tr><th colspan="3">上記以外の売上先の計</th><td class="num"><fmt:formatNumber value="${x.salesPartnerOther}" pattern="#,##0" /></td></tr>
                    <tr class="is-total"><th colspan="3">計（雑収入を除く）</th><td class="num"><fmt:formatNumber value="${x.salesTotal}" pattern="#,##0" /></td></tr>
                </tbody>
            </table>
            <table class="tr-sheet-table">
                <caption>仕入金額の明細</caption>
                <thead><tr><th>仕入先名</th><th>所在地</th><th>登録番号（法人番号）</th><th class="num">仕入金額（円）</th></tr></thead>
                <tbody>
                    <c:forEach var="p" items="${x.purchasePartnerRows}"><tr><td><c:out value="${p.name}" /></td><td><c:out value="${p.address}" /></td><td class="tr-blank"></td><td class="num"><fmt:formatNumber value="${p.amount}" pattern="#,##0" /></td></tr></c:forEach>
                    <tr><th colspan="3">上記以外の仕入先の計</th><td class="num"><fmt:formatNumber value="${x.purchasePartnerOther}" pattern="#,##0" /></td></tr>
                    <tr class="is-total"><th colspan="3">計</th><td class="num"><fmt:formatNumber value="${x.purchaseTotal}" pattern="#,##0" /></td></tr>
                </tbody>
            </table>
        </div>
        <p class="tr-sheet-note">売上先・仕入先は取引に登録した取引先ごとに集計し、金額の大きい順に表示しています。登録番号（法人番号）は本アプリで管理しないため、転記時に記入してください。</p>
        <table class="tr-sheet-table">
            <caption>減価償却費の計算</caption>
            <thead><tr><th>減価償却資産の名称等</th><th>面積又は数量</th><th>取得年月</th><th class="num">取得価額<br />（償却保証額）</th><th class="num">償却の基礎になる金額</th><th>償却方法</th><th class="num">耐用年数</th><th class="num">償却率又は改定償却率</th><th class="num">本年中の償却期間</th><th class="num">本年分の普通償却費</th><th class="num">割増（特別）償却費</th><th class="num">本年分の償却費合計</th><th class="num">事業専用割合</th><th class="num">本年分の必要経費算入額</th><th class="num">未償却残高（期末残高）</th><th>摘要</th></tr></thead>
            <tbody>
                <c:forEach var="a" items="${x.assets}">
                    <tr><th><c:out value="${a.name}" /></th><td class="tr-blank"></td><td><c:out value="${a.acquired}" /></td><td class="num"><fmt:formatNumber value="${a.cost}" pattern="#,##0" /></td><td class="num"><fmt:formatNumber value="${a.depreciationBasis}" pattern="#,##0.##" /></td><td><c:out value="${a.methodLabel}" /></td><td class="num"><c:out value="${a.usefulLife}" default="-" /></td><td class="num"><c:out value="${a.rate}" default="-" /></td><td class="num">${a.months}/12</td><td class="num"><fmt:formatNumber value="${a.depreciation}" pattern="#,##0" /></td><td class="num">0</td><td class="num"><fmt:formatNumber value="${a.depreciation}" pattern="#,##0" /></td><td class="num"><fmt:formatNumber value="${a.businessRatio}" pattern="0.##" />%</td><td class="num"><fmt:formatNumber value="${a.businessPortion}" pattern="#,##0" /></td><td class="num"><fmt:formatNumber value="${a.closing}" pattern="#,##0" /></td><td><c:out value="${a.notes}" /></td></tr>
                </c:forEach>
                <tr class="is-total"><th colspan="11">計</th><td class="num"><fmt:formatNumber value="${x.depreciationTotal}" pattern="#,##0" /></td><td></td><td class="num"><fmt:formatNumber value="${x.depreciationBusinessTotal}" pattern="#,##0" /></td><td class="num"><fmt:formatNumber value="${x.assetClosingTotal}" pattern="#,##0" /></td><td></td></tr>
            </tbody>
        </table>
        <p class="tr-sheet-note">割増（特別）償却は本アプリ対象外のため0円です。面積又は数量は転記時に記入してください。</p>
        <c:forEach var="a" items="${x.assets}"><p class="tr-desc"><c:out value="${a.name}" />：<c:out value="${a.calculationDetails}" /></p></c:forEach>
        <table class="tr-sheet-table">
            <caption>固定資産の売却・除却・事業専用割合変更の履歴</caption>
            <thead><tr><th>資産</th><th>内容</th><th>適用日</th><th class="num">変更割合（%）</th><th class="num">売却価額（円）</th></tr></thead>
            <tbody><c:forEach var="e" items="${x.fixedAssetEvents}"><tr><th><c:out value="${e.assetName}" /></th><td><c:out value="${e.eventTypeLabel}" /></td><td><c:out value="${e.effectiveDate}" /></td><td class="num"><c:if test="${not empty e.businessRatio}"><fmt:formatNumber value="${e.businessRatio}" pattern="0.##" /></c:if></td><td class="num"><c:if test="${not empty e.proceeds}"><fmt:formatNumber value="${e.proceeds}" pattern="#,##0" /></c:if></td></tr></c:forEach></tbody>
        </table>
        <div class="tr-sheet-grid">
            <table class="tr-sheet-table">
                <caption>利子割引料の内訳（金融機関を除く）</caption>
                <thead><tr><th>支払先の住所・氏名</th><th class="num">期末現在の借入金等の金額</th><th class="num">本年中の利子割引料</th><th class="num">左のうち必要経費算入額</th></tr></thead>
                <tbody><c:forEach var="p" items="${x.interestRows}"><tr><td><c:out value="${p.address}" /> <c:out value="${p.name}" /></td><td class="num tr-blank"></td><td class="num"><fmt:formatNumber value="${p.amount}" pattern="#,##0" /></td><td class="num"><fmt:formatNumber value="${p.deductible}" pattern="#,##0" /></td></tr></c:forEach></tbody>
            </table>
            <table class="tr-sheet-table">
                <caption>税理士・弁護士等の報酬・料金の内訳</caption>
                <thead><tr><th>支払先の住所・氏名</th><th class="num">本年中の報酬等の金額</th><th class="num">左のうち必要経費算入額</th><th class="num">源泉徴収税額</th></tr></thead>
                <tbody><c:forEach var="p" items="${x.feeRows}"><tr><td><c:out value="${p.address}" /> <c:out value="${p.name}" /></td><td class="num"><fmt:formatNumber value="${p.amount}" pattern="#,##0" /></td><td class="num"><fmt:formatNumber value="${p.deductible}" pattern="#,##0" /></td><td class="num tr-blank"></td></tr></c:forEach></tbody>
            </table>
        </div>
        <table class="tr-sheet-table">
            <caption>本年中における特殊事情</caption>
            <tbody><tr><td class="tr-blank">（該当がある場合は転記時に記入）</td></tr></tbody>
        </table>
    </div>

    <div class="tr-sheet-page">
        <h2 class="tr-sheet-title">4ページ　貸借対照表（資産負債調）　<c:out value="${page.yearLabel}" />12月31日現在・製造原価の計算</h2>
        <div class="tr-sheet-grid">
            <table class="tr-sheet-table">
                <caption>資産の部</caption>
                <thead><tr><th>科目</th><th class="num">1月1日（期首）</th><th class="num">12月31日（期末）</th></tr></thead>
                <tbody>
                    <c:forEach var="r" items="${page.assets}"><tr><th><c:out value="${r.label}" /></th><td class="num"><fmt:formatNumber value="${r.opening}" pattern="#,##0" /></td><td class="num"><fmt:formatNumber value="${r.closing}" pattern="#,##0" /></td></tr></c:forEach>
                    <tr class="is-total"><th>合計</th><td class="num"><fmt:formatNumber value="${page.assetsOpening}" pattern="#,##0" /></td><td class="num"><fmt:formatNumber value="${page.assetsClosing}" pattern="#,##0" /></td></tr>
                </tbody>
            </table>
            <table class="tr-sheet-table">
                <caption>負債・資本の部</caption>
                <thead><tr><th>科目</th><th class="num">1月1日（期首）</th><th class="num">12月31日（期末）</th></tr></thead>
                <tbody>
                    <c:forEach var="r" items="${page.liabilities}"><tr><th><c:out value="${r.label}" /></th><td class="num"><fmt:formatNumber value="${r.opening}" pattern="#,##0" /></td><td class="num"><fmt:formatNumber value="${r.closing}" pattern="#,##0" /></td></tr></c:forEach>
                    <tr class="is-total"><th>合計</th><td class="num"><fmt:formatNumber value="${page.liabilitiesOpening}" pattern="#,##0" /></td><td class="num"><fmt:formatNumber value="${page.liabilitiesClosing}" pattern="#,##0" /></td></tr>
                </tbody>
            </table>
        </div>
        <p class="tr-sheet-note">科目は帳簿の勘定科目名で表示しています。正式様式では該当する科目欄（現金・当座預金・定期預金・その他の預金・受取手形・売掛金・…・事業主借・元入金）へ転記し、該当欄のない科目は空欄の科目欄に科目名を記入してください。</p>
        <table class="tr-sheet-table">
            <caption>製造原価の計算</caption>
            <tbody><tr><td class="tr-blank">原価計算を行っている場合のみ記入します。本アプリは製造原価の計算に対応していないため、該当する場合は正式様式で作成してください。</td></tr></tbody>
        </table>
        <p class="tr-sheet-note">本書は青色申告決算書（一般用）の記載項目に沿って本アプリが作成した帳票です（国税庁の公式用紙ではありません）。提出時は確定申告書等作成コーナー等で正式な様式に転記するか、様式と照合のうえご利用ください。</p>
    </div>
</section>
