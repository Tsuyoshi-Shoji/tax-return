# Systemd service unit file for Tomcat
# /etc/systemd/system/tomcat.service

[Unit]
Description=Apache Tomcat 11
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=forking
User=tomcat
Group=tomcat
Environment="CATALINA_PID=/opt/tomcat/run/catalina.pid"
Environment="CATALINA_HOME=/opt/tomcat"
Environment="CATALINA_BASE=/opt/tomcat"
Environment="JAVA_HOME=/usr/lib/jvm/java-21-amazon-corretto.aarch64"
Environment="JAVA_OPTS=-Xms1024m -Xmx2048m -XX:+UseG1GC"

ExecStart=/opt/tomcat/bin/catalina.sh start
ExecStop=/opt/tomcat/bin/catalina.sh stop

Restart=on-abnormal
RestartSec=10s

# Security settings
PrivateTmp=yes
NoNewPrivileges=yes
LimitNOFILE=65535
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tomcat

[Install]
WantedBy=multi-user.target
